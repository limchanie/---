--  ПОВНА СХЕМА турагенції (виправлена версія)
--  УВАГА: скрипт ВИДАЛЯЄ старі таблиці і створює їх заново,
--  тобто всі дані в них зникнуть. Запускати ПЕРШИМ.
--  Це ОДИН повний файл: схема + готелі + тури. Запускати цілком, один раз.
-- ============================================================
-- Назва бази даних (можна змінити на свою, але в обох рядках однакову)
CREATE DATABASE IF NOT EXISTS `travel_agency` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE `travel_agency`;

SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS `booking`;
DROP TABLE IF EXISTS `tour_hotel`;
DROP TABLE IF EXISTS `tour_country`;
DROP TABLE IF EXISTS `tour`;
DROP TABLE IF EXISTS `hotel`;
DROP TABLE IF EXISTS `client`;
DROP TABLE IF EXISTS `employee`;
DROP TABLE IF EXISTS `office`;
SET FOREIGN_KEY_CHECKS = 1;

CREATE TABLE `office` (
	`office_id` int AUTO_INCREMENT NOT NULL,
	`office_name` varchar(30) NOT NULL,
	`city` varchar(30) NOT NULL,
	`street` varchar(40) NOT NULL,
	`building_no` int,
	PRIMARY KEY (`office_id`),
	UNIQUE KEY `uq_office_name` (`office_name`),
	UNIQUE KEY `uq_office_address` (`city`, `street`, `building_no`)
);
CREATE TABLE `employee` (
	`employee_id` int AUTO_INCREMENT NOT NULL,
	`user_name` varchar(30) NOT NULL,
	`first_name` varchar(30) NOT NULL,
	`last_name` varchar(30) NOT NULL,
	`position` varchar(15) NOT NULL,
	`employment_date` date NOT NULL,
	`office_id` int,
	`manager_id` int,
	`rate` float NOT NULL,
	`bonus` float,
	PRIMARY KEY (`employee_id`),
	UNIQUE KEY `uq_employee_user_name` (`user_name`)
);
CREATE TABLE `client` (
	`client_id` int AUTO_INCREMENT NOT NULL,
	`first_name` varchar(30) NOT NULL,
	`last_name` varchar(30) NOT NULL,
	`gender` varchar(1) NOT NULL,
	`birth_date` date NOT NULL,
	`phone_number` varchar(13) NOT NULL,
	`email` varchar(50) NOT NULL,
	`discount` int,
	PRIMARY KEY (`client_id`),
	UNIQUE KEY `uq_client_email` (`email`),
	UNIQUE KEY `uq_client_phone` (`phone_number`)
);
CREATE TABLE `hotel` (
	`hotel_id` int AUTO_INCREMENT NOT NULL,
	`hotel_name` varchar(40) NOT NULL,
	`country` varchar(30) NOT NULL,
	`city` varchar(30) NOT NULL,
	`stars` int NOT NULL,
	`price_per_night` float NOT NULL,
	`meal_plan` varchar(2) NOT NULL,
	PRIMARY KEY (`hotel_id`),
	UNIQUE KEY `uq_hotel_name_city` (`hotel_name`, `city`)
);
CREATE TABLE `tour` (
	`tour_id` int AUTO_INCREMENT NOT NULL,
	`tour_name` varchar(50) NOT NULL,
	`tour_type` varchar(20) NOT NULL,
	`transport` varchar(20) NOT NULL,
	`start_date` date NOT NULL,
	`end_date` date NOT NULL,
	`price` float NOT NULL,
	`seats_total` int NOT NULL,
	PRIMARY KEY (`tour_id`),
	UNIQUE KEY `uq_tour_name_start` (`tour_name`, `start_date`),
	CHECK (`end_date` > `start_date`)
);
CREATE TABLE `tour_country` (
	`tour_id` int NOT NULL,
	`country` varchar(30) NOT NULL,
	PRIMARY KEY (`tour_id`, `country`)
);
CREATE TABLE `tour_hotel` (
	`tour_id` int NOT NULL,
	`hotel_id` int NOT NULL,
	`stop_order` int NOT NULL,
	`nights` int NOT NULL,
	PRIMARY KEY (`tour_id`, `stop_order`)
);
CREATE TABLE `booking` (
	`booking_id` int AUTO_INCREMENT NOT NULL,
	`employee_id` int NOT NULL,
	`client_id` int NOT NULL,
	`tour_id` int,
	`hotel_id` int,
	`booking_date` date NOT NULL,
	`check_in_date` date,
	`check_out_date` date,
	`guests_count` int NOT NULL,
	`payment_type` varchar(15) NOT NULL,
	`payment_status` varchar(15) NOT NULL,
	PRIMARY KEY (`booking_id`)
);

ALTER TABLE `employee` ADD CONSTRAINT `employee_fk6` FOREIGN KEY (`office_id`) REFERENCES `office`(`office_id`);
ALTER TABLE `employee` ADD CONSTRAINT `employee_fk7` FOREIGN KEY (`manager_id`) REFERENCES `employee`(`employee_id`);
ALTER TABLE `tour_country` ADD CONSTRAINT `tour_country_fk1` FOREIGN KEY (`tour_id`) REFERENCES `tour`(`tour_id`);
ALTER TABLE `tour_hotel` ADD CONSTRAINT `tour_hotel_fk1` FOREIGN KEY (`tour_id`) REFERENCES `tour`(`tour_id`);
ALTER TABLE `tour_hotel` ADD CONSTRAINT `tour_hotel_fk2` FOREIGN KEY (`hotel_id`) REFERENCES `hotel`(`hotel_id`);
ALTER TABLE `booking` ADD CONSTRAINT `booking_fk1` FOREIGN KEY (`employee_id`) REFERENCES `employee`(`employee_id`);
ALTER TABLE `booking` ADD CONSTRAINT `booking_fk2` FOREIGN KEY (`client_id`) REFERENCES `client`(`client_id`);
ALTER TABLE `booking` ADD CONSTRAINT `booking_fk3` FOREIGN KEY (`tour_id`) REFERENCES `tour`(`tour_id`);
ALTER TABLE `booking` ADD CONSTRAINT `booking_fk4` FOREIGN KEY (`hotel_id`) REFERENCES `hotel`(`hotel_id`);

